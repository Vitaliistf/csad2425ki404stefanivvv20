  rankdir="LR";
  Node0 [id="Node000000",label="GameStrategy",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_game_strategy.html",tooltip="Defines a strategy interface for generating moves in different game modes."];
  Node0 -> Node1 [id="edge1_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
