  Node0 -> Node2 [id="edge2_Node000000_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="SmartStrategy",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$class_smart_strategy.html",tooltip="Adapts to the opponent's moves, increasing the chance of countering frequent moves."];
}
