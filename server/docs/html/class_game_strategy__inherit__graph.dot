digraph "GameStrategy"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="GameStrategy",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Defines a strategy interface for generating moves in different game modes."];
  Node1 -> Node2 [id="edge1_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="RandomStrategy",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$class_random_strategy.html",tooltip="Generates random moves for the computer."];
  Node1 -> Node3 [id="edge2_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="SmartStrategy",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$class_smart_strategy.html",tooltip="Adapts to the opponent's moves, increasing the chance of countering frequent moves."];
}
